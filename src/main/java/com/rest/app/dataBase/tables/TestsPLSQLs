DROP FUNCTION IF EXISTS select_orders();

CREATE FUNCTION select_orders() RETURNS TABLE ("like" orders)
AS
$$
BEGIN
    RETURN QUERY SELECT * FROM orders ORDER BY order_number;
END;
$$ STABLE LANGUAGE plpgsql;

SELECT select_orders();

