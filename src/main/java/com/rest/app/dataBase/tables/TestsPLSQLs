DROP FUNCTION IF EXISTS insert_make_order(data_time timestamp, name varchar, service varchar, pay_int integer);

CREATE OR REPLACE FUNCTION insert_make_order(data_time timestamp, name varchar, service varchar, pay_int integer) RETURNS void
AS
$$
BEGIN
    INSERT INTO orders(date, fk_customer_name, fk_service, pay)
    VALUES (data_time, name, service, pay_int);
END;
$$ LANGUAGE plpgsql;


