DROP FUNCTION IF EXISTS make_order2();

CREATE FUNCTION make_order2(data_time timestamp, name varchar, service varchar, pay_int integer)
    RETURNS TABLE
            (
                "like" orders
            )
AS
$$
BEGIN
    INSERT INTO orders(date, fk_customer_name, fk_service, pay) VALUES (data_time, name, service, pay_int);
END;
$$ STABLE LANGUAGE plpgsql;

--- 2020-07-24 12:23:42.210282
SELECT make_order2('2020-07-24 12:23:42.210282', 'Bob', 'TV', 300);


DROP FUNCTION IF EXISTS make_order(data_time timestamp, name varchar, service varchar, pay_int integer);

CREATE OR REPLACE FUNCTION make_order(data_time timestamp, name varchar, service varchar, pay_int integer)
    RETURNS void
AS
$$
BEGIN
    INSERT INTO orders(date, fk_customer_name, fk_service, pay)
    VALUES (data_time, name, service, pay_int);
END;
$$ VOLATILE LANGUAGE plpgsql;


SELECT make_order('2020-07-24 12:23:42.210282', 'Bob', 'TV', 300);

SELECT * FROM make_order('2020-07-24 12:23:42.210282', 'Bob', 'TV', 300);

